{
  "name": "@lib/mobile",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "portless \"$(../../scripts/portless-app-name.sh mobile.lib)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start",
    "dev:android": "portless \"$(../../scripts/portless-app-name.sh mobile.lib)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start --android",
    "dev:ios": "portless \"$(../../scripts/portless-app-name.sh mobile.lib)\" --lan node ../../scripts/expo-portless-bridge.mjs expo start --ios",
    "android": "pnpm run dev:android",
    "ios": "pnpm run dev:ios",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.10",
    "@expo/ui": "~57.0.11",
    "@legendapp/list": "^3.3.5",
    "@lib/ebook-core": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.12",
    "expo-file-system": "~57.0.4",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-icon-handler": "^0.1.7",
    "expo-image-picker": "~57.0.13",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-sharing": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "react-native": "catalog:react19",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "~0.10.1",
    "rostra": "catalog:",
    "tailwindcss": "catalog:",
    "uniwind": "catalog:"
  },
  "devDependencies": {
    "@lib/eslint-config": "workspace:*",
    "@lib/prettier-config": "workspace:*",
    "@lib/tailwind-config": "workspace:*",
    "@lib/tsconfig": "workspace:*",
    "@react-native/metro-config": "0.86.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "drizzle-kit": "^0.31.4",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.0.17"
  },
  "prettier": "@lib/prettier-config"
}
